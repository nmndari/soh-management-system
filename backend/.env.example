# Сервер
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Өгөгдлийн сан
# msnodesqlv8: Windows нэвтрэлтээр (SQL Server Express локал дээр)
# tedious:     SQL нэвтрэлтээр (Docker, өөр компьютер). DB_USER, DB_PASSWORD, DB_PORT шаардлагатай
DB_DRIVER=msnodesqlv8
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=SohManagementDB
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_USER=
DB_PASSWORD=
DB_PORT=1433

# Апп
DEFAULT_SOH_ID=1
# true: OTP кодыг SMS-ээр илгээхгүй, консол болон хариунд (devCode) буцаана. Бодит орчинд false
OTP_DEV_MODE=true
# Гомдлын зураг хадгалах хавтас (backend/-ээс харьцангуй)
UPLOAD_DIR=uploads

# JWT — бодит орчинд урт санамсаргүй утга тавина
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
